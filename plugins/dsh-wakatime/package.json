{
  "name": "@27aaron/dsh-wakatime",
  "version": "0.3.0",
  "description": "WakaTime tracking for DeepSeek Harness (headless core; add @27aaron/dsh-wakatime-ui for the web dashboard)",
  "author": "Aaron",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./ui-contract": {
      "types": "./lib/types/ui-contract.d.ts",
      "default": "./lib/ui-contract.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/ui-contract.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/27Aaron/agent-toolkit.git",
    "directory": "plugins/dsh-wakatime"
  },
  "homepage": "https://github.com/27Aaron/agent-toolkit/tree/main/plugins/dsh-wakatime#readme",
  "bugs": {
    "url": "https://github.com/27Aaron/agent-toolkit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm exec publint",
    "prepare": "pnpm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh-session": ">=0.1.1-rc.2 <0.2",
    "@deepseek-ai/dsh-tools": ">=0.1.1-rc.2 <0.2",
    "@deepseek-ai/schemastery": ">=3.18.1 <4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.1",
    "@types/node": "^22.20.0",
    "@vitest/coverage-v8": "^4.1.8",
    "publint": "^0.3.21",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "wakatime",
    "ai-coding",
    "productivity",
    "time-tracking"
  ]
}
